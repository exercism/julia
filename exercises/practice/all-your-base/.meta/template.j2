{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{%- macro test_case(case) %}
{%- if case["cases"] %}
    @testset "{{ case["description"] }}" begin
    {%- for subcase in case["cases"] %}
        {{ test_case(subcase) }}
    {% endfor %}
    end
{%- else %}
    @testset "{{ case["description"] }}" begin
    {%- set i = case["input"] %}
    {%- set digits = macros.julia_vector(i["digits"]) if i["digits"] else "Int[]" %}
    {%- if case is error_case %}
        @test_throws DomainError all_your_base({{ digits }}, {{ i["inputBase"] }}, {{ i["outputBase"] }})
    {%- else %}
        @test all_your_base({{ digits }}, {{ i["inputBase"] }}, {{ i["outputBase"] }}) == {{ macros.julia_vector(case["expected"]) }}
    {%- endif %}
    end
{%- endif %}
{%- endmacro %}
{% for case in cases %}
    {{ test_case(case) }}
{% endfor %}
end
