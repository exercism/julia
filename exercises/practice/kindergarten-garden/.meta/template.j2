{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{%- macro test_case(case) %}
{%- if case["cases"] %}
    @testset "{{ case["description"] }}" begin
    {%- for subcase in case["cases"] %}
        {{ test_case(subcase) }}
    {% endfor %}
    end
{%- else %}
    @testset "{{ case["description"] }}" begin
        @test plants({{ macros.julia_string(case["input"]["diagram"]) }}, "{{ case["input"]["student"] }}") == {{ macros.julia_vector(case["expected"]) }}
    end
{%- endif %}
{%- endmacro %}
{% for case in cases %}
    {{ test_case(case) }}
{% endfor %}
end
