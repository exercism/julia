{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

using Test
using Dates

include("clock.jl")

@testset verbose = true "tests" begin
{%- macro clock(c) -%}
Clock({{ c["hour"] }}, {{ c["minute"] }})
{%- endmacro %}
{#- "08:05" -> Clock(8, 5) #}
{%- macro parsed(s) -%}
{%- set hm = s.split(":") -%}
Clock({{ hm[0] | int }}, {{ hm[1] | int }})
{%- endmacro %}
{%- macro test_case(case) %}
{%- if case["cases"] %}
    @testset "{{ case["description"] }}" begin
    {%- for subcase in case["cases"] %}
        {{ test_case(subcase) }}
    {% endfor %}
    end
{%- else %}
    @testset "{{ case["description"] }}" begin
    {%- set i = case["input"] %}
    {%- if case["property"] == "create" %}
        @test {{ clock(i) }} == {{ parsed(case["expected"]) }}
        @test sprint(show, {{ clock(i) }}) == "\"{{ case["expected"] }}\""
    {%- elif case["property"] == "add" %}
        @test {{ clock(i) }} + Dates.Minute({{ i["value"] }}) == {{ parsed(case["expected"]) }}
    {%- elif case["property"] == "subtract" %}
        @test {{ clock(i) }} - Dates.Minute({{ i["value"] }}) == {{ parsed(case["expected"]) }}
    {%- else %}
        @test {{ clock(i["clock1"]) }} {% if case["expected"] %}=={% else %}!={% endif %} {{ clock(i["clock2"]) }}
    {%- endif %}
    end
{%- endif %}
{%- endmacro %}
{% for case in cases %}
    {{ test_case(case) }}
{% endfor %}
end
