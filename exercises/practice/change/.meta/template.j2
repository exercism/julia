{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{%- macro test_case(case) %}
{%- if case["cases"] %}
    @testset "{{ case["description"] }}" begin
    {%- for subcase in case["cases"] %}
        {{ test_case(subcase) }}
    {% endfor %}
    end
{%- else %}
    @testset "{{ case["description"] }}" begin
    {%- if case is error_case %}
        @test_throws DomainError change({{ macros.julia_vector(case["input"]["coins"]) }}, {{ case["input"]["target"] }})
    {%- else %}
        @test change({{ macros.julia_vector(case["input"]["coins"]) }}, {{ case["input"]["target"] }}) == {{ macros.julia_vector(case["expected"]) }}
    {%- endif %}
    end
{%- endif %}
{%- endmacro %}
{% for case in cases %}
    {{ test_case(case) }}
{% endfor %}
end
