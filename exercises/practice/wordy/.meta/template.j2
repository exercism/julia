{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{%- macro test_case(case) %}
{%- if case["cases"] %}
    @testset "{{ case["description"] }}" begin
    {%- for subcase in case["cases"] %}
        {{ test_case(subcase) }}
    {% endfor %}
    end
{%- else %}
    @testset "{{ case["description"] }}" begin
    {%- if case is error_case %}
        @test_throws ArgumentError wordy({{ macros.julia_string(case["input"]["question"]) }})
    {%- else %}
        @test wordy({{ macros.julia_string(case["input"]["question"]) }}) == {{ case["expected"] }}
    {%- endif %}
    end
{%- endif %}
{%- endmacro %}
{% for case in cases %}
    {{ test_case(case) }}
{% endfor %}
end
