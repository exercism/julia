{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{%- macro test_case(case) %}
    @testset "{{ case["description"] }}" begin
    {%- if case is error_case %}
        @test_throws DomainError on_square({{ case["input"]["square"] }})
    {%- elif case["property"] == "square" %}
        @test on_square({{ case["input"]["square"] }}) == {{ case["expected"] }}
    {%- else %}
        @test total_after(64) == {{ case["expected"] }}
    {%- endif %}
    end
{%- endmacro %}
{% for case in cases %}
{%- if case["cases"] %}
    @testset "{{ case["description"] }}" begin
    {%- for subcase in case["cases"] %}
        {{ test_case(subcase) }}
    {% endfor %}
    end
{%- else %}
    {{ test_case(case) }}
{%- endif %}
{% endfor %}
end
