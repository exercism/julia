{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{% for case in cases + additional_cases %}
    {%- set sentence = case["input"]["sentence"] | replace("\\", "\\\\") | replace('"', '\\"') | replace("$", "\\$") %}
    @testset "{{ case["description"] }}" begin
        @test {% if not case["expected"] %}!{% endif %}ispangram("{{ sentence }}")
    end
{% endfor %}
end
