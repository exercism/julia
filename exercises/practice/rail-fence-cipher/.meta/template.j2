{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{% for group in cases %}
    @testset "{{ group["description"] }}" begin
    {%- for case in group["cases"] %}
        @testset "{{ case["description"] }}" begin
            @test {{ case["property"] }}({{ macros.julia_string(case["input"]["msg"]) }}, {{ case["input"]["rails"] }}) == {{ macros.julia_string(case["expected"]) }}
        end
    {% endfor %}
    end
{% endfor %}
end
