{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{% for case in cases %}
    @testset "{{ case["description"] }}" begin
    {%- if case is error_case %}
        @test_throws ErrorException slices({{ macros.julia_string(case["input"]["series"]) }}, {{ case["input"]["sliceLength"] }})
    {%- else %}
        @test slices({{ macros.julia_string(case["input"]["series"]) }}, {{ case["input"]["sliceLength"] }}) == {{ macros.julia_vector(case["expected"]) }}
    {%- endif %}
    end
{% endfor %}
end
