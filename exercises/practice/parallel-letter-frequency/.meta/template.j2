    end
{% endfor %}

    @testset "parallelism test" begin
        global function calculate_frequencies(text::String)
            thread = Dict{Char, Int}()
            for c in lowercase.(filter(isletter, text))
                thread[c] = Threads.threadid()
            end
            thread
        end

        @test calculate_frequencies(["abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc",
                                    "abbccc", "abbccc", "abbccc", "abbccc", "abbccc"])['a'] > 50
    end
end
