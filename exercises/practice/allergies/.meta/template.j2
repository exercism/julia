{%- import "generator_macros.j2" as macros with context -%}
{{ macros.canonical_ref() }}

{{ macros.header() }}
{%- macro test_case(case) %}
{%- if case["cases"] %}
    @testset "{{ case["description"] }}" begin
    {%- for subcase in case["cases"] %}
        {{ test_case(subcase) }}
    {% endfor %}
    end
{%- else %}
    @testset "{{ case["description"] }}" begin
    {%- if case["property"] == "list" %}
        @test allergy_list({{ case["input"]["score"] }}) == Set({{ macros.julia_vector(case["expected"]) }})
    {%- else %}
        @test {% if not case["expected"] %}!{% endif %}allergic_to({{ case["input"]["score"] }}, "{{ case["input"]["item"] }}")
    {%- endif %}
    end
{%- endif %}
{%- endmacro %}
{% for case in cases %}
    {{ test_case(case) }}
{% endfor %}
end
